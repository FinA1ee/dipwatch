# Copy to deploy/.env. `make dev` does this for you with random values.
POSTGRES_PASSWORD=change-me
# At least 32 characters. Shared by gateway and core-api.
CORE_INTERNAL_TOKEN=change-me-to-a-random-string-of-32-or-more-characters
# Host port for the site.
HTTP_PORT=18080
# Set by the deploy script on the server.
IMAGE_REPO=dipwatch
IMAGE_TAG=local
# Host port for Postgres (localhost only). Default avoids clashing with other local Postgres.
PG_HOST_PORT=25432
# Browsing agent (any OpenAI-compatible API). Leave LLM_API_KEY empty to keep it off.
# Prices are yuan per million tokens, from the provider's price list (DeepSeek flash, peak hours).
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_PRICE_IN_CNY_PER_M=2
LLM_PRICE_OUT_CNY_PER_M=8
# DeepSeek: turn off "thinking", which adds output tokens the agent does not need.
LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
# Sign-in (Better Auth in the gateway). Leave BETTER_AUTH_SECRET empty to turn it off.
# PUBLIC_URL is the site address users open: base of magic links and the GitHub callback.
PUBLIC_URL=http://localhost:18080
# At least 32 random characters, e.g. `openssl rand -hex 32`.
BETTER_AUTH_SECRET=
# Magic-link email over SMTP, e.g. smtps://you%40qq.com:<app code>@smtp.qq.com:465.
# Empty locally: the gateway prints the link to its log instead (development only).
SMTP_URL=
MAIL_FROM=
# GitHub OAuth app; callback URL <PUBLIC_URL>/api/auth/callback/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated emails that may open /admin.
ADMIN_EMAILS=
# development locally (prints magic links); production on the server.
NODE_ENV=development
